# ─────────── MIKORI API — Configuración por ambiente ───────────
# Copia este archivo a .env y ajusta los valores.

APP_ENV=local
APP_DEBUG=true
CORS_ORIGIN=*

# ─────────── Base de datos ───────────
# Driver: sqlite (desarrollo/pruebas) | mysql (producción)
DB_DRIVER=sqlite

# SQLite (solo si DB_DRIVER=sqlite)
DB_SQLITE_PATH=storage/mikori.sqlite

# MySQL (solo si DB_DRIVER=mysql)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mikori
DB_USERNAME=root
DB_PASSWORD=

# ─────────── Tokens / seguridad ───────────
# Vida del access/refresh token en minutos (por defecto 30 días).
TOKEN_TTL_MINUTES=43200
# Vida del token de recuperación de contraseña (minutos).
RESET_TTL_MINUTES=60
# Vida del código de vinculación MIKORI-XXXXXX (minutos).
LINK_CODE_TTL_MINUTES=15
